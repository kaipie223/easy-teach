# DeepSeek API
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# App
APP_NAME=easy-teach
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# Database
DATABASE_URL=sqlite:///./data/easy_teach.db

# Runtime directories
DATA_DIR=./data
GENERATED_DIR=./generated
CHROMA_PERSIST_DIR=./data/chroma

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
