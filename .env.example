# DeepSeek API (local development only; production uses Docker secrets below)
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional vision model, e.g. deepseek-v4-flash-vision-exp. When empty, uploaded
# pictures are stored and selectable but never described to the text model.
DEEPSEEK_VISION_MODEL=

# Auth
JWT_SECRET_KEY=change-this-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_NAME=easy-teach
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# Database
DATABASE_URL=sqlite:///./data/easy_teach.db
REDIS_URL=redis://localhost:6379/0
TASK_QUEUE_ENABLED=true
TASK_QUEUE_EAGER=false
TASK_QUEUE_NAME=easy_teach
TASK_MAX_RETRIES=2
TASK_TIME_LIMIT_SECONDS=900
TASK_SOFT_TIME_LIMIT_SECONDS=840
TASK_STALE_AFTER_SECONDS=1800
TASK_RETRY_BACKOFF_SECONDS=15
RATE_LIMIT_REQUESTS_PER_MINUTE=300
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=60
DAILY_MODEL_REQUEST_LIMIT=200
MAX_CONCURRENT_TASKS_PER_USER=8
STORAGE_QUOTA_MB_PER_USER=1024

# Runtime directories
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
GENERATED_DIR=./data/generated
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=./data/embedding-models
EMBEDDING_THREADS=2
ANONYMIZED_TELEMETRY=false

# Upload
MAX_UPLOAD_SIZE_MB=50
SPEECH_MAX_UPLOAD_SIZE_MB=25
UPLOAD_CHUNK_SIZE_KB=1024

# Production Compose secret file paths. Keep the secret values out of .env.
DEEPSEEK_API_KEY_SECRET_FILE=./secrets/deepseek_api_key.txt
JWT_SECRET_KEY_SECRET_FILE=./secrets/jwt_secret_key.txt
POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password.txt
# Repository-external file containing the Bailian key; never place the key in this file.
BAILIAN_API_KEY_SECRET_FILE=/etc/easy-teach/secrets/bailian_api_key

# Video material parser
VIDEO_PARSER_ENABLED=false
VIDEO_PARSER_OUTPUT_DIR=./data/video-parser
VIDEO_PARSER_TYPE=auto
VIDEO_PARSER_TRANSCRIBE=false
VIDEO_PARSER_OCR=false
VIDEO_PARSER_VISION=false
VIDEO_PARSER_UNDERSTANDING=false
VIDEO_PARSER_MAX_KEYFRAMES=12
VIDEO_PARSER_MAX_SHOTS=36
VIDEO_PARSER_OUTPUT_WIDTH=960
VIDEO_PARSER_MAX_DURATION_SECONDS=3600
VIDEO_PARSER_TASK_TIME_LIMIT_SECONDS=1800
VIDEO_PARSER_TASK_SOFT_TIME_LIMIT_SECONDS=1740
VIDEO_PARSER_DAILY_USER_LIMIT=10

# Full-video Bailian understanding (recommended first-phase model).
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VIDEO_MODEL=qwen3.7-plus
VIDEO_INPUT_MODE=file_url
VIDEO_FPS=1.0
VIDEO_MAX_FRAMES=1800
VIDEO_CHUNK_SECONDS=1800
VIDEO_CHUNK_OVERLAP_SECONDS=15
VIDEO_MAX_CHUNKS=4
VIDEO_TIMEOUT_SECONDS=300
VIDEO_MAX_RETRIES=1
VIDEO_MAX_OUTPUT_TOKENS=4096
VIDEO_MAX_BASE64_BYTES=12582912
VIDEO_STRICT_SCHEMA=true
VIDEO_CACHE_ENABLED=true
VIDEO_PROMPT_VERSION=video-understanding-v1
VIDEO_SCHEMA_VERSION=video-understanding-v1

# Candidate refinement and single-frame Bailian verification budgets.
VIDEO_MAX_REFINEMENT_INTERVALS=6
VIDEO_MAX_REFINEMENT_FRAMES=12
VIDEO_MAX_VISUAL_FRAMES_PER_INTERVAL=4
VIDEO_PARSER_VISION_MAX_KEYFRAMES=4
BAILIAN_VISION_MODEL=qwen3.7-plus
BAILIAN_VISION_TIMEOUT_SECONDS=90
BAILIAN_VISION_MAX_RETRIES=1
BAILIAN_VISION_MAX_OUTPUT_TOKENS=1800

# For local development, point to one repository-external credential file.
# BAILIAN_API_KEY_FILE=/path/outside/repository/to/bailian_api_key
# TENCENT_OCR_ENABLED=false
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=

# 成果编辑里的「AI 生成配图」（火山方舟 ARK · Seedream）。
# 不配置时接口返回 IMAGE_GEN_NOT_CONFIGURED，编辑页仍可手工上传图片，功能不会假装可用。
# ARK_API_KEY=            # 方舟控制台的 API Key；也可用 ARK_API_KEY_FILE 指向密钥文件
# ARK_IMAGE_MODEL=doubao-seedream-4-0-250828
# ARK_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_IMAGE_SIZE=1024x1024
# ARK_IMAGE_TIMEOUT_SECONDS=180
#
# 生成课件时"每页自动配图"：在渲染产物之前逐页生成插图，图片随同一个成果版本落库，
# 所以不会每配一张图就多一个版本。缺 ARK key 时自动跳过；结构版式页（卡片/流程/目录
# 等）会跳过，避免整页退回普通要点版式。
# SLIDE_ILLUSTRATION_ENABLED=true
# SLIDE_ILLUSTRATION_LIMIT=8
# SLIDE_ILLUSTRATION_CONCURRENCY=3
