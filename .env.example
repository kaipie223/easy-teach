# DeepSeek API (local development only; production uses Docker secrets below)
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Auth
JWT_SECRET_KEY=change-this-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_NAME=easy-teach
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*

# Database
DATABASE_URL=sqlite:///./data/easy_teach.db
REDIS_URL=redis://localhost:6379/0
TASK_QUEUE_ENABLED=true
TASK_QUEUE_EAGER=false
TASK_QUEUE_NAME=easy_teach
TASK_MAX_RETRIES=2
TASK_TIME_LIMIT_SECONDS=900
TASK_SOFT_TIME_LIMIT_SECONDS=840
TASK_STALE_AFTER_SECONDS=1800
TASK_RETRY_BACKOFF_SECONDS=15
RATE_LIMIT_REQUESTS_PER_MINUTE=300
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=60
DAILY_MODEL_REQUEST_LIMIT=200
MAX_CONCURRENT_TASKS_PER_USER=8
STORAGE_QUOTA_MB_PER_USER=1024

# Runtime directories
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
GENERATED_DIR=./data/generated
CHROMA_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=./data/embedding-models
EMBEDDING_THREADS=2
ANONYMIZED_TELEMETRY=false

# Upload
MAX_UPLOAD_SIZE_MB=50
SPEECH_MAX_UPLOAD_SIZE_MB=25
UPLOAD_CHUNK_SIZE_KB=1024

# Production Compose secret file paths. Keep the secret values out of .env.
DEEPSEEK_API_KEY_SECRET_FILE=./secrets/deepseek_api_key.txt
JWT_SECRET_KEY_SECRET_FILE=./secrets/jwt_secret_key.txt
POSTGRES_PASSWORD_SECRET_FILE=./secrets/postgres_password.txt

# Video material parser
VIDEO_PARSER_ENABLED=false
VIDEO_PARSER_OUTPUT_DIR=./data/video-parser
VIDEO_PARSER_TYPE=auto
VIDEO_PARSER_TRANSCRIBE=false
VIDEO_PARSER_OCR=false
VIDEO_PARSER_VISION=false
VIDEO_PARSER_UNDERSTANDING=false
VIDEO_PARSER_MAX_KEYFRAMES=12
VIDEO_PARSER_MAX_SHOTS=36
VIDEO_PARSER_OUTPUT_WIDTH=960

# Optional cloud vision/OCR credentials are read only from local env or files.
# DASHSCOPE_API_KEY=
# BAILIAN_API_KEY_FILE=
# TENCENT_OCR_ENABLED=false
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
